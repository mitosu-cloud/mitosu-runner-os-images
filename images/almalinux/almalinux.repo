[baseos]
name=AlmaLinux 10.2 - BaseOS
baseurl=https://repo.almalinux.org/almalinux/10.2/BaseOS/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-AlmaLinux-10
metadata_expire=never

[appstream]
name=AlmaLinux 10.2 - AppStream
baseurl=https://repo.almalinux.org/almalinux/10.2/AppStream/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-AlmaLinux-10
metadata_expire=never

[crb]
name=AlmaLinux 10.2 - CRB
baseurl=https://repo.almalinux.org/almalinux/10.2/CRB/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-AlmaLinux-10
metadata_expire=never

[extras]
name=AlmaLinux 10.2 - Extras
baseurl=https://repo.almalinux.org/almalinux/10.2/extras/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-AlmaLinux-10
metadata_expire=never
