{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mitosu.dev/schemas/runtime-pack-v1.json",
  "title": "Mitosu sandbox runtime pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "target_os",
    "target_arch",
    "artifacts",
    "oci_images"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pack_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"
    },
    "target_os": { "enum": ["linux", "macos", "windows"] },
    "target_arch": { "enum": ["aarch64", "x86_64"] },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/definitions/artifact" }
    },
    "oci_images": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/definitions/ociImage" }
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "size", "sha256", "executable"],
      "properties": {
        "name": { "$ref": "#/definitions/name" },
        "path": { "$ref": "#/definitions/portablePath" },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        },
        "sha256": { "$ref": "#/definitions/sha256" },
        "executable": { "type": "boolean" }
      }
    },
    "ociImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reference"],
      "properties": {
        "name": { "$ref": "#/definitions/name" },
        "reference": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
