{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mitosu.dev/schemas/runtime-pack-v1.json",
  "title": "Mitosu sandbox runtime pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "target_os",
    "target_arch",
    "artifacts",
    "oci_images"
  ],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "pack_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"
    },
    "target_os": { "enum": ["linux", "macos", "windows"] },
    "target_arch": { "enum": ["aarch64", "x86_64"] },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/definitions/artifact" }
    },
    "oci_images": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/definitions/ociImage" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": 2 } },
        "required": ["schema_version"]
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "oci_images": {
                "contains": {
                  "type": "object",
                  "required": ["name"],
                  "properties": { "name": { "const": "openshell_supervisor_image" } }
                }
              }
            }
          },
          {
            "properties": {
              "oci_images": {
                "contains": {
                  "type": "object",
                  "required": ["name"],
                  "properties": { "name": { "const": "openshell_sandbox_runtime_image" } }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "definitions": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "size", "sha256", "executable"],
      "properties": {
        "name": { "$ref": "#/definitions/name" },
        "path": { "$ref": "#/definitions/portablePath" },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        },
        "sha256": { "$ref": "#/definitions/sha256" },
        "executable": { "type": "boolean" }
      }
    },
    "ociImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reference"],
      "properties": {
        "name": { "$ref": "#/definitions/name" },
        "reference": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "attestation": { "$ref": "#/definitions/runtimeImageAttestation" }
      }
    },
    "runtimeImageAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "image_id",
        "profile_revision",
        "guest_target",
        "marker_sha256",
        "runner_protocol",
        "runner_source_digest",
        "tool_uid",
        "tool_gid",
        "capabilities"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "image_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9-][a-z0-9.-]*$"
        },
        "profile_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "guest_target": {
          "enum": [
            "linux_aarch64",
            "linux_x86_64",
            "macos_aarch64",
            "macos_x86_64",
            "windows_aarch64",
            "windows_x86_64"
          ]
        },
        "marker_sha256": { "$ref": "#/definitions/sha256" },
        "runner_protocol": { "const": "mitosu.runner.v1" },
        "runner_source_digest": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "tool_uid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "tool_gid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/name" }
        },
        "toolchains": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "$ref": "#/definitions/name" },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[ -~]+$"
          }
        }
      }
    }
  }
}
