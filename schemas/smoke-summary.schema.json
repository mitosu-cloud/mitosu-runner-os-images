{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mitosu.dev/schemas/runner-os-smoke-summary-v1.json",
  "title": "Mitosu runner OS image smoke summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "image_id",
    "architecture",
    "source_revision",
    "image_reference",
    "runner_version",
    "execution",
    "duration_seconds",
    "status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "image_id": { "type": "string", "minLength": 1 },
    "architecture": { "enum": ["amd64", "arm64", "unknown"] },
    "source_revision": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        { "const": "unknown" }
      ]
    },
    "image_reference": { "type": "string", "minLength": 1 },
    "runner_version": { "type": "string" },
    "execution": { "enum": ["native", "emulated", "unknown"] },
    "duration_seconds": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["passed", "failed"] }
  }
}
